rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is who ──────────────────────────────────────────────────────────
    //  • STAFF = signed in to dispatch with an email + password.
    //  • TIMESHEET PHONES = signed in anonymously. Any device that opens the
    //    timesheet site gets one of these automatically, BEFORE the Employee
    //    ID + PIN screen — and anyone on the internet can get one with the
    //    public web config. So an anonymous token only proves "someone opened
    //    the app", never "this is an employee".
    function signedIn() { return request.auth != null; }
    function isStaff()  { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // ── What the timesheet phone app needs (anonymous for now) ──────────────
    // Still open to any signed-in device. Phase B (PIN check moved to a Cloud
    // Function that signs each phone in AS that employee) will scope these to
    // each person's own records.
    match /timesheets/{doc}         { allow read, write: if signedIn(); }
    match /sessions/{doc}           { allow read, write: if signedIn(); }
    match /expenses/{doc}           { allow read, write: if signedIn(); }
    match /employees/{doc}          { allow read, write: if signedIn(); }
    match /employee_documents/{doc} { allow read, write: if signedIn(); }
    match /acknowledgments/{doc}    { allow read, write: if signedIn(); }
    match /orders/{doc}             { allow read, write: if signedIn(); }   // driver Orders tab reads + updates
    match /drivers/{doc}            { allow read, write: if signedIn(); }   // login lookup (Phase B removes this)

    // Phones only READ these; only staff (dispatch) may change them.
    match /events/{doc}             { allow read: if signedIn(); allow write: if isStaff(); }
    match /trucks/{doc}             { allow read: if signedIn(); allow write: if isStaff(); }
    match /trailers/{doc}           { allow read: if signedIn(); allow write: if isStaff(); }
    match /company_docs/{doc}       { allow read: if signedIn(); allow write: if isStaff(); }
    match /driver_shared_docs/{doc} { allow read: if signedIn(); allow write: if isStaff(); }

    // ── Everything else — clients, quotes, settings, letters, IFTA, stickers,
    // locations, maintenance, config… — dispatch staff only.
    // (Previously ANY signed-in device, including anonymous ones.)
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
