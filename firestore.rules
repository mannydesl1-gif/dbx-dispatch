rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Tightened: was `if true` (world-readable AND writable). Now requires
    // an auth token. Both apps authenticate (dispatch login; timesheet
    // signInAnonymously), so legitimate users still pass. This closes public
    // internet access; it does NOT scope each driver to their own record
    // (anonymous tokens are interchangeable) — that would need real per-driver auth.
    match /timesheets/{doc} { allow read, write: if request.auth != null; }
    match /sessions/{doc} { allow read, write: if request.auth != null; }
    match /expenses/{doc} { allow read, write: if request.auth != null; }
    match /employees/{doc} { allow read, write: if request.auth != null; }

    // Driver-uploaded docs (void cheque, licence, headshot) — driver → manager.
    // Was read:if true; now auth-gated. Writes already fell through to the
    // authenticated catch-all, so keep write auth'd here explicitly.
    match /employee_documents/{doc} { allow read, write: if request.auth != null; }

    // Company → driver shared docs (drug screens, border letters). Read by the
    // driver's timesheet app; written only by dispatch (authenticated admin).
    // NEW collection for the upcoming feature.
    match /driver_shared_docs/{doc} { allow read, write: if request.auth != null; }

    // Was read:if true — now auth-gated. Events writes stay admin-authed.
    match /events/{doc} { allow read, write: if request.auth != null; }
    match /drivers/{doc} { allow read, write: if request.auth != null; }
    match /trucks/{doc} { allow read, write: if request.auth != null; }
    match /trailers/{doc} { allow read, write: if request.auth != null; }
    match /company_docs/{doc} { allow read, write: if request.auth != null; }

    // Everything else (orders, settings, letters, …) already required auth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
